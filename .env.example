# Runtime
NODE_ENV=development
# India Standard Time (UTC+05:30)
TZ=Asia/Kolkata
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# LogicX Loom Platform API and Web
PLATFORM_API_PORT=9350
PLATFORM_API_URL=http://127.0.0.1:9350
PLATFORM_WEB_PORT=9360
PLATFORM_WEB_ORIGIN=http://127.0.0.1:9360
PLATFORM_WEB_ORIGINS=capacitor://localhost,https://localhost,http://localhost
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:9360/status
VITE_PLATFORM_API_URL=http://127.0.0.1:9350
VITE_MOBILE_API_URL=http://127.0.0.1:9350
VITE_DEV_AUTO_LOGIN=0

# Flutter build environment. The build script compiles only the matching API URL.
# Use 10.0.2.2 to reach the host API from an Android emulator.
MOBILE_APP_ENVIRONMENT=development
MOBILE_DEVELOPMENT_API_URL=http://10.0.2.2:9350
MOBILE_PRODUCTION_API_URL=https://log.logicx.in/api/platform
MOBILE_DEVELOPMENT_AUTO_LOGIN=0
MOBILE_UPDATE_URL=https://log.logicx.in/storage/mobile/release/update.json

# Local development database.
# Container setup replaces these three values in .container/.env from deploy.env.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=logicx_loom
DB_PASSWORD=
DB_NAME=logicx_loom_db

# Messaging attachment storage. This local folder is replaced by the R2 adapter later.
MESSAGE_MEDIA_STORAGE_ROOT=./storage/messaging
MESSAGE_MEDIA_MAX_UPLOAD_BYTES=10485760

# Authentication and protected administrator
JWT_SECRET=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@logicxloom.in
INITIAL_ADMIN_PASSWORD=

# Optional dedicated Frappe credential encryption key.
# When empty, LogicX Loom derives credential encryption from JWT_SECRET.
LOGICX_LOOM_INTEGRATION_ENCRYPTION_KEY=


# Live Frappe connection
# Container deployment overrides this with the mounted root .env path.
LOGICX_LOOM_ENV_FILE_PATH=
FRAPPE_ENABLED=1
FRAPPE_CONNECTION_NAME=Frappe
FRAPPE_BASE_URL=
FRAPPE_APP_KEY=
FRAPPE_APP_SECRET=
FRAPPE_LAST_CHECKED_AT=
FRAPPE_LAST_VERIFIED_AT=
FRAPPE_UPDATED_AT=
FRAPPE_VERIFICATION_STATUS=unverified

# Destructive database reset remains disabled
LOGICX_LOOM_DB_FRESH_ON_START=0
LOGICX_LOOM_DB_RESET_CONFIRM=
LOGICX_LOOM_ALLOW_PRODUCTION_DB_RESET=0
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra
AI_TIMEOUT_MS=120000
