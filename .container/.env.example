# LogicX Loom production runtime
NODE_ENV=production
# India Standard Time (UTC+05:30)
TZ=Asia/Kolkata
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# LogicX Loom Platform API and Web
PLATFORM_API_PORT=9350
PLATFORM_API_URL=https://log.logicx.in/api/platform
PLATFORM_WEB_PORT=19360
PLATFORM_WEB_ORIGIN=https://log.logicx.in
PLATFORM_WEB_ORIGINS=
PLATFORM_WEB_HEALTH_URL=https://log.logicx.in/health
VITE_PLATFORM_API_URL=/api/platform
VITE_DEV_AUTO_LOGIN=0

# Setup synchronizes DB_USER, DB_PASSWORD, and DB_NAME from deploy.env.
DB_DRIVER=mariadb
DB_HOST=codexsun-mariadb
DB_PORT=3306
DB_USER=logicx_loom
DB_PASSWORD=Computer.1
DB_NAME=logicx_loom_db

# Authentication and protected administrator
JWT_SECRET=generate-with-setup
INITIAL_ADMIN_NAME=Mahendran
INITIAL_ADMIN_EMAIL=mahendran@logicxloom.in
INITIAL_ADMIN_PASSWORD=

# Optional dedicated Frappe credential encryption key.
# When empty, LogicX Loom derives credential encryption from JWT_SECRET.
LOGICX_LOOM_INTEGRATION_ENCRYPTION_KEY=

# Optional machine key for POST /loomdata. Send it in the X-Loom-Key header.
LOGICX_LOOM_INGEST_KEY=

# Live Frappe connection
FRAPPE_ENABLED=1
FRAPPE_CONNECTION_NAME=Frappe
FRAPPE_BASE_URL=https://logicx.tmnext.in
FRAPPE_APP_KEY=
FRAPPE_APP_SECRET=
FRAPPE_LAST_CHECKED_AT=
FRAPPE_LAST_VERIFIED_AT=
FRAPPE_UPDATED_AT=
FRAPPE_VERIFICATION_STATUS=unverified

# Destructive database reset remains disabled
LOGICX_LOOM_DB_FRESH_ON_START=0
LOGICX_LOOM_DB_RESET_CONFIRM=
LOGICX_LOOM_ALLOW_PRODUCTION_DB_RESET=0
