# Docker project and images
LOGICX_LOOM_COMPOSE_PROJECT=logicx-loom
LOGICX_LOOM_IMAGE_REGISTRY=logicx-loom
LOGICX_LOOM_VERSION=1.0.3
LOGICX_LOOM_IMAGE_TAG=1.0.3
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1

# Guarded application updates
# Must match LOGICX_LOOM_VERSION after migrations and repeatable seeds are reviewed
# as compatible with the currently running application image.
LOGICX_LOOM_MIGRATION_COMPATIBLE_VERSION=1.0.3
LOGICX_LOOM_BACKUP_RETENTION=10
LOGICX_LOOM_UPDATE_MIN_BACKUP_FREE_MB=1024
LOGICX_LOOM_UPDATE_MIN_DOCKER_FREE_MB=5120

# Docker resources
LOGICX_LOOM_API_CONTAINER_NAME=logicx-loom-api
LOGICX_LOOM_WEB_CONTAINER_NAME=logicx-loom-web
LOGICX_LOOM_MARIADB_CONTAINER_NAME=logicx-loom-mariadb
LOGICX_LOOM_NETWORK=logicx-loom-network
LOGICX_LOOM_NETWORK_EXTERNAL=false
LOGICX_LOOM_MARIADB_DATA_VOLUME=logicx-loom-mariadb-data

# Loopback publishing
LOGICX_LOOM_BIND_ADDRESS=127.0.0.1
LOGICX_LOOM_API_INTERNAL_PORT=9350
LOGICX_LOOM_API_HOST_PORT=19350
LOGICX_LOOM_WEBSOCKET_HOST_PORT=19351
LOGICX_LOOM_WEB_HOST_PORT=19360

# Standalone MariaDB infrastructure
MARIADB_IMAGE=mariadb:11.8
MARIADB_ROOT_PASSWORD=generate-with-setup
DB_USER=logicx_loom
DB_PASSWORD=generate-with-setup
DB_NAME=logicx_loom_db

# Optional reuse of an already-running shared infrastructure stack.
# LogicX Loom connects only to MariaDB; Redis and Media are detected but unused.
LOGICX_LOOM_SHARED_MARIADB_CONTAINER_NAME=cxapp-mariadb
LOGICX_LOOM_SHARED_REDIS_CONTAINER_NAME=cxapp-redis
LOGICX_LOOM_SHARED_MEDIA_CONTAINER_NAME=cxapp-media
LOGICX_LOOM_SHARED_MARIADB_ROOT_PASSWORD=
